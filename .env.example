# LP Manager V0.5 live read-only configuration
LP_MANAGER_DEMO_SEED=false
LP_MANAGER_EXECUTION_MODE=build_only
LP_MANAGER_CURRENCY=GBP
LP_MANAGER_LIVE_REFRESH_SECONDS=60
LP_MANAGER_POSITION_SCAN_BLOCKS=500000

# PUBLIC address only. Never put a seed phrase or private key here.
WALLET_ADDRESS=0xYOUR_PUBLIC_WALLET_ADDRESS

# Configure only the chains you use. Missing chains remain unavailable, not fatal.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
RH_RPC_URL=

# Optional provider upgrades
GECKOTERMINAL_ENABLED=true
THEGRAPH_API_KEY=
COINGECKO_API_KEY=

# Optional existing project integration
LP_MANAGER_LEGACY_ROOT=C:\Users\deano\Documents\crypto-lp-bot

# Later integrations (not required for live read-only data)
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
