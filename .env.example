# LP Manager V0.8
LP_MANAGER_DEMO_SEED=false
LP_MANAGER_EXECUTION_MODE=build_only
LP_MANAGER_CURRENCY=GBP
LP_MANAGER_LIVE_REFRESH_SECONDS=60
LP_MANAGER_POSITION_SCAN_BLOCKS=500000
LP_MANAGER_AUTO_IMPORT_LEGACY=true

# Public wallet address only. Never store a seed phrase or private key here.
WALLET_ADDRESS=0xYOUR_PUBLIC_WALLET_ADDRESS

# RPC strategy:
# 1) Explicit per-chain URLs below win.
# 2) If ALCHEMY_API_KEY is set, V0.8 derives Alchemy URLs for supported chains.
# 3) Otherwise read-only public RPC fallbacks are available on every chain.
# Broad NFT log scans intentionally require explicit/Alchemy RPCs by default.
ALCHEMY_API_KEY=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
RH_RPC_URL=
LP_MANAGER_ALLOW_PUBLIC_RPC=true
LP_MANAGER_SCAN_PUBLIC_RPC=false
LP_MANAGER_WALLET_MIN_VISIBLE_USD=1

# Market / research providers
GECKOTERMINAL_ENABLED=true
THEGRAPH_API_KEY=
COINGECKO_API_KEY=

# Advisory AI. Without a key, all AI buttons fall back to deterministic analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
LP_MANAGER_AI_ENABLED=true
LP_MANAGER_AI_WEB_SEARCH=false

# Existing DELTA / Village project. V0.8 imports campaign history and merges live
# NFT reads by chain + token ID rather than creating duplicate records.
LP_MANAGER_LEGACY_ROOT=C:\Users\deano\Documents\crypto-lp-bot

# Notifications (future/optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
